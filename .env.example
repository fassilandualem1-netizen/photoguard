# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PhotoGuard Production Database (Neon.tech PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/photoguard?sslmode=require"

# PhotoGuard Security & Auth
JWT_SECRET="photoguard_super_secret_jwt_signing_key_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# PhotoGuard Redis (Upstash) Live Sync
REDIS_URL="rediss://default:your_password@your-endpoint.upstash.io:6379"

# Multi-Cloud Storage (IDrive e2 S3 API)
S3_ENDPOINT_URL="https://s3.us-east-1.idrivee2-2.com"
S3_ACCESS_KEY="your_idrive_e2_access_key"
S3_SECRET_KEY="your_idrive_e2_secret_key"
S3_BUCKET_NAME="photoguard-production"

# Cloudinary Permanent Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# CDNs & Optimization (Cloudflare & ImageKit)
CLOUDFLARE_CDN_DOMAIN="https://cdn.photoguard.com"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/photoguard"

# Telegram Bot Notification Engine
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"



